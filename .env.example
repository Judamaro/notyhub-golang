# Copy to .env and adjust. Every variable is optional in development (APP_ENV=development).
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
METRICS_ADDR=:9465
METRICS_PATH=/metrics
JWT_ISSUER=notyhub
JWT_AUDIENCE=notyhub-clients
JWT_SIGNING_KEY=development-only-signing-key-change-me-0123456789
API_KEY_HEADER=X-Api-Key
API_KEYS=dev-api-key-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
REALTIME_HUB_PATH=/ws/notifications
REALTIME_CLIENT_ID_CLAIM=sub
REALTIME_CLIENT_ID_QUERY=clientId
REALTIME_USER_ID_QUERY=userId
